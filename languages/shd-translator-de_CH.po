#: includes/admin/class-admin.php:370
#, php-format
msgid "Until it works, %1$s translates your site instead (%2$s text so far); those texts are redone with %3$s automatically afterwards."
msgid_plural "Until it works, %1$s translates your site instead (%2$s texts so far); those texts are redone with %3$s automatically afterwards."
msgstr[0] "Bis er funktioniert, übersetzt %1$s Ihre Website an seiner Stelle (bisher %2$s Text); diese Texte werden danach automatisch mit %3$s neu übersetzt."
msgstr[1] "Bis er funktioniert, übersetzt %1$s Ihre Website an seiner Stelle (bisher %2$s Texte); diese Texte werden danach automatisch mit %3$s neu übersetzt."

#. translators: 1: engine names, 2: selected engine
#: includes/admin/class-admin.php:377
#, php-format
msgid "Until it works, %1$s translates new texts instead; they are redone with %2$s automatically afterwards."
msgstr "Bis er funktioniert, übersetzt %1$s neue Texte an seiner Stelle; sie werden danach automatisch mit %2$s neu übersetzt."

#: includes/admin/class-admin.php:382
msgid "Until it works, new texts stay in the original language (\"Fall back to the free engines\" is off)."
msgstr "Bis er funktioniert, bleiben neue Texte in der Originalsprache («Auf die kostenlosen Dienste ausweichen» ist ausgeschaltet)."

